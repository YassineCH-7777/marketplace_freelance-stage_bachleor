APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=http://localhost:8080/api
POSTGRES_DB=marketplace_freelance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/marketplace_freelance?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-local-only
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-base64-32-byte-secret
JWT_EXPIRATION=86400000

# Firebase Auth. Enable Email/Password in Firebase Console.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=

# Google client ID used by the frontend Google button and backend token verifier.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=

# Commission ProxiSkills appliquee au paiement libere (0 a 100).
PLATFORM_FEE_PERCENTAGE=10

# Optional map tile provider for Leaflet. Leave empty to use OpenStreetMap public tiles in local development.
# Example: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Optional AI assistant webhooks.
VITE_N8N_CHAT_URL=
VITE_N8N_CLIENT_CHAT_URL=
VITE_N8N_FREELANCE_CHAT_URL=
